<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <config>
    <!-- Keep downloaded packages on D:, next to the project -->
    <add key="globalPackagesFolder" value=".build-cache\nuget-packages" />
  </config>
</configuration>
