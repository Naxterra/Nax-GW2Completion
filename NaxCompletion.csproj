<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>NaxCompletion</AssemblyName>
    <RootNamespace>Nax.Completion</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.4.0</Version>
    <!-- BlishHUD.targets zips the output into NaxCompletion.bhm next to the dll -->
    <BlishHUDModuleFileName>NaxCompletion</BlishHUDModuleFileName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);.build-cache\**;dist\**;dev\**</DefaultItemExcludes>
    <!-- dev\ holds the test harness stubs; compiling them in would shadow the real Blish HUD types -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Blish HUD already ships these assemblies; compile against them, do not copy them into the .bhm -->
    <PackageReference Include="BlishHUD" Version="1.0.0" ExcludeAssets="runtime;contentFiles;analyzers" />
    <!-- Lets the SDK build net48 without the .NET Framework Developer Pack installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Jumping puzzle list (names, maps, nearest waypoints), read at runtime from the assembly -->
    <EmbeddedResource Include="data\puzzles.json" LogicalName="Nax.Completion.puzzles.json" />
    <EmbeddedResource Include="data\puzzle_routes.json" LogicalName="Nax.Completion.puzzle_routes.json" />
    <EmbeddedResource Include="data\vista_routes.json" LogicalName="Nax.Completion.vista_routes.json" />
    <EmbeddedResource Include="data\map_index.json" LogicalName="Nax.Completion.map_index.json" />
  </ItemGroup>

</Project>
